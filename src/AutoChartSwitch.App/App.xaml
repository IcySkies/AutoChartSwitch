<Application x:Class="AutoChartSwitch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F5F7" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D5D9DE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#167D6B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#106657" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B33A3A" />
        <Style TargetType="Window">
            <Setter Property="Icon" Value="Assets/Icon.ico" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="Foreground" Value="#20252B" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Application.Resources>
</Application>
